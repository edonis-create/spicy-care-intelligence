      },
      {
        "metric_id": "cohort_driver_group",
        "label": "Driver group",
        "data_file": "feature_importance_summary.csv",
        "field": "product_group",
        "format": "text"
      },
      {
        "metric_id": "cohort_feature_rank",
        "label": "Feature rank",
        "data_file": "feature_importance_summary.csv",
        "field": "rank_gain",
        "format": "integer"
      }
    ],
    "charts": [
      {
        "chart_id": "cohort_feature_importance",
        "title": "Top Risk Drivers",
        "type": "horizontal_bar",
        "data_file": "feature_importance_summary.csv",
        "x": "importance_gain",
        "y": "feature",
        "purpose": "Explain aggregate high-risk cohort drivers without implying causality."
      },
      {
        "chart_id": "cohort_driver_groups",
        "title": "Driver Categories",
        "type": "bar",
        "data_file": "feature_importance_summary.csv",
        "x": "product_group",
        "y": "count",
        "aggregation": "count_rows",
        "purpose": "Group drivers into clinical and utilization categories for end users."
      }
    ]
  },
  {
    "page": "Partner Sites",
