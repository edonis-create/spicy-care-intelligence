  {
    "page": "Trust & Validation",
    "route": "/trust-validation",
    "metrics": [
      {
        "metric_id": "trust_model_auroc",
        "label": "AUROC",
        "data_file": "centralized_vs_federated_metrics.csv",
        "field": "AUROC",
        "format": "decimal"
      },
      {
        "metric_id": "trust_model_auprc",
        "label": "AUPRC",
        "data_file": "centralized_vs_federated_metrics.csv",
        "field": "AUPRC",
        "format": "decimal"
      },
      {
        "metric_id": "trust_model_brier",
        "label": "Brier score",
        "data_file": "centralized_vs_federated_metrics.csv",
        "field": "Brier",
        "format": "decimal"
      },
      {
        "metric_id": "trust_temporal_auroc",
        "label": "Temporal AUROC",
        "data_file": "temporal_validation_metrics.csv",
        "field": "AUROC",
        "format": "decimal"
      },
      {
        "metric_id": "trust_validation_status",
        "label": "Validation engine status",
        "data_file": "validation_engine_summary.json",
        "field": "current_status",
        "format": "status"
      }
    ],
    "charts": [
      {
        "chart_id": "trust_model_comparison",
        "title": "Model Comparison",
        "type": "grouped_bar",
        "data_file": "centralized_vs_federated_metrics.csv",
        "x": "model_id",
        "y": [
          "AUROC",
          "AUPRC",
          "Brier"
        ],
        "purpose": "Compare model evidence directionally across centralized and collaborative candidates."
      },
      {
        "chart_id": "trust_temporal_stability",
        "title": "Temporal Stability",
        "type": "multi_line",
        "data_file": "temporal_validation_metrics.csv",
        "x": "prediction_year",
        "series": "probability_version",
        "y": [
          "AUROC",
          "AUPRC",
          "Brier score"
        ],
        "purpose": "Show rolling-window performance and calibration stability."
      },
      {
        "chart_id": "trust_calibration",
        "title": "Calibration Comparison",
        "type": "grouped_bar",
        "data_file": "calibration_summary.csv",
        "x": "probability_version",
        "y": [
          "Brier score",
          "log loss"
        ],
        "purpose": "Show why calibrated probabilities are preferred for risk communication."
      },
      {
        "chart_id": "trust_collaborative_training_trend",
        "title": "Collaborative Training Trend",
        "type": "multi_line",
        "data_file": "fl_training_rounds.csv",
        "x": "round",
        "y": [
          "global_weighted_auroc",
          "global_weighted_auprc",
          "global_weighted_brier"
        ],
        "purpose": "Show aggregate proof-of-concept training behavior without exposing low-level internals."
      }
    ]
  },
