[
  {
    "page": "Overview",
    "route": "/overview",
    "metrics": [
      {
        "metric_id": "overview_total_population",
        "label": "Total population",
        "data_file": "project_summary.json",
        "field": "total_patients",
        "format": "integer"
      },
      {
        "metric_id": "overview_expected_onsets",
        "label": "Expected onset cases",
        "data_file": "project_summary.json",
        "field": "total_positives",
        "format": "integer"
      },
      {
        "metric_id": "overview_positive_rate",
        "label": "Observed positive rate",
        "data_file": "project_summary.json",
        "field": "positive_rate",
        "format": "percent"
      },
      {
        "metric_id": "overview_partner_sites",
        "label": "Partner sites",
        "data_file": "project_summary.json",
        "field": "federated_clients",
        "format": "integer"
      },
      {
        "metric_id": "overview_fl_auroc",
        "label": "Collaborative AUROC",
        "data_file": "project_summary.json",
        "field": "best_federated_auroc",
        "format": "decimal"
      },
      {
        "metric_id": "overview_fl_recall",
        "label": "Collaborative recall",
        "data_file": "project_summary.json",
        "field": "best_federated_recall",
        "format": "percent"
      }
    ],
    "charts": [
      {
        "chart_id": "overview_population_composition",
        "title": "Population Composition",
        "type": "donut",
        "data_file": "project_summary.json",
        "fields": [
          "total_positives",
          "total_negatives"
        ],
        "purpose": "Show the rare-event class balance without using accuracy."
      },
      {
        "chart_id": "overview_model_status",
        "title": "Current Model Status",
        "type": "status_cards",
        "data_file": "model_registry.json",
        "fields": [
          "model_id",
          "training_mode",
          "calibration_status",
          "product_role"
        ],
        "purpose": "Show which models are benchmarks, calibrated candidates, and proof-of-concept collaborative models."
      },
      {
        "chart_id": "overview_partner_population",
        "title": "Partner Site Population",
        "type": "horizontal_bar",
        "data_file": "fl_client_summary.csv",
        "x": "population",
        "y": "site_id",
        "purpose": "Show aggregate population contribution by synthetic partner site."
      }
    ]
  },
  {
    "page": "Risk Population",
    "route": "/risk-population",
    "metrics": [
      {
        "metric_id": "risk_top_1_placeholder",
        "label": "Top 1% band",
        "data_file": "threshold_analysis_summary.csv",
        "field": "top_k_percent",
        "format": "percent",
        "status": "pending_final_risk_band_scoring"
      },
      {
        "metric_id": "risk_top_5_placeholder",
        "label": "Top 5% band",
        "data_file": "threshold_analysis_summary.csv",
        "field": "top_k_percent",
        "format": "percent",
        "status": "pending_final_risk_band_scoring"
      },
      {
        "metric_id": "risk_threshold_precision",
        "label": "Precision by threshold",
        "data_file": "threshold_analysis_summary.csv",
        "field": "precision",
        "format": "percent"
      },
      {
        "metric_id": "risk_threshold_recall",
        "label": "Recall by threshold",
        "data_file": "threshold_analysis_summary.csv",
        "field": "recall_sensitivity",
        "format": "percent"
      }
    ],
    "charts": [
      {
        "chart_id": "risk_threshold_tradeoff",
        "title": "Threshold Tradeoff",
        "type": "multi_line",
        "data_file": "threshold_analysis_summary.csv",
        "x": "threshold",
        "y": [
          "precision",
          "recall_sensitivity",
          "specificity"
        ],
        "purpose": "Show how threshold selection changes precision, recall, and specificity."
      },
      {
        "chart_id": "risk_predicted_positive_rate",
        "title": "Workload by Threshold",
        "type": "line",
        "data_file": "threshold_analysis_summary.csv",
        "x": "threshold",
        "y": "predicted_positive_rate",
        "purpose": "Show how much of the population would be selected at each threshold."
      },
      {
        "chart_id": "risk_band_table",
        "title": "Risk Band Summary",
        "type": "table",
        "data_file": "threshold_analysis_summary.csv",
        "fields": [
          "planning_mode",
          "top_k_percent",
          "precision",
          "recall_sensitivity",
          "predicted_positive_rate",
          "status"
        ],
        "purpose": "Provide the schema for future top-k risk bands."
      }
    ]
  },
  {
    "page": "Intervention Planner",
    "route": "/intervention-planner",
    "metrics": [
      {
        "metric_id": "planner_selected_population_rate",
        "label": "Selected population rate",
        "data_file": "threshold_analysis_summary.csv",
        "field": "predicted_positive_rate",
        "format": "percent"
      },
      {
        "metric_id": "planner_expected_captured",
        "label": "Expected positives captured",
        "data_file": "threshold_analysis_summary.csv",
        "field": "true_positives",
        "format": "integer"
      },
      {
        "metric_id": "planner_false_positives",
        "label": "Expected false positives",
        "data_file": "threshold_analysis_summary.csv",
        "field": "false_positives",
        "format": "integer"
      },
      {
        "metric_id": "planner_missed_positives",
        "label": "Missed positives",
        "data_file": "threshold_analysis_summary.csv",
        "field": "false_negatives",
        "format": "integer"
      },
      {
        "metric_id": "planner_number_needed_to_review",
        "label": "Number needed to review",
        "data_file": "threshold_analysis_summary.csv",
        "field": "precision",
        "format": "derived_inverse"
      }
    ],
    "charts": [
      {
        "chart_id": "planner_capacity_curve",
        "title": "Capacity Curve",
        "type": "combo_line_bar",
        "data_file": "threshold_analysis_summary.csv",
        "x": "threshold",
        "bar_y": "predicted_positive_rate",
        "line_y": "recall_sensitivity",
        "purpose": "Support capacity planning by connecting workload and captured cases."
      },
      {
        "chart_id": "planner_confusion_counts",
        "title": "Expected Outcome Counts",
        "type": "stacked_bar",
        "data_file": "threshold_analysis_summary.csv",
        "x": "threshold",
        "y": [
          "true_positives",
          "false_positives",
          "false_negatives"
        ],
        "purpose": "Show the operational tradeoff between captured cases, review burden, and missed cases."
      }
    ]
  },
  {
    "page": "Cohort Insights",
    "route": "/cohort-insights",
    "metrics": [
      {
        "metric_id": "cohort_top_driver",
